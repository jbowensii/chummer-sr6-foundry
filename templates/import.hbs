<div class="sr6i">
  {{#if systemError}}<p class="sr6i-error" role="alert">{{systemError}}</p>{{/if}}
  {{#if systemWarning}}<p class="sr6i-warning" role="status">{{systemWarning}}</p>{{/if}}

  {{#if report}}
    <h3>{{localize "SR6I.ReportTitle"}}</h3>
    <ul class="sr6i-report">
      {{#each report}}
      <li>
        <strong>{{name}}</strong>{{#if outcome}}: <span class="{{#if failed}}sr6i-error{{/if}}">{{outcome}}</span>{{/if}}
        {{#if textOnly.length}}
          <div class="sr6i-textonly">{{localize "SR6I.TextOnly"}}
            <ul>{{#each textOnly}}<li>{{this}}</li>{{/each}}</ul>
          </div>
        {{/if}}
      </li>
      {{/each}}
    </ul>
    <footer class="form-footer">
      {{#each report}}{{#if actorId}}
        <button type="button" data-action="openActor" data-actor-id="{{actorId}}"><i class="fas fa-user"></i> {{openLabel}}</button>
      {{/if}}{{/each}}
      <button type="button" data-action="done"><i class="fas fa-check"></i> {{localize "SR6I.Close"}}</button>
    </footer>
  {{else}}
    {{#unless systemError}}
      <label class="sr6i-file">{{localize "SR6I.ChooseFile"}}
        <input type="file" name="file" accept=".json,application/json" {{#if busy}}disabled{{/if}}>
      </label>
      {{#if refused}}<p class="sr6i-error" role="alert">{{refused}}</p>{{/if}}
    {{/unless}}

    {{#if rows}}
      {{#if summary}}<p>{{summary}}</p>{{/if}}
      <label class="sr6i-all">{{localize "SR6I.ApplyAll"}}
        <select name="applyAll">
          <option value="">—</option>
          <option value="replace">{{localize "SR6I.Replace"}}</option>
          <option value="new">{{localize "SR6I.New"}}</option>
          <option value="skip">{{localize "SR6I.Skip"}}</option>
        </select>
      </label>
      <ul class="sr6i-rows">
        {{#each rows}}
        <li class="sr6i-row">
          <input type="checkbox" name="tick-{{@index}}" checked aria-label="{{../includeLabel}}: {{name}}">
          {{#if portrait}}<img src="{{portrait}}" alt="">{{else}}<i class="fas fa-user sr6i-noportrait"></i>{{/if}}
          <div class="sr6i-info">
            <strong>{{name}}</strong>{{#if npc}} <span class="sr6i-date">{{npc}}</span>{{/if}} <span class="sr6i-date">{{exported}}</span>
            {{#if inWorld}}
              <div class="{{#if older}}sr6i-error{{/if}}">{{inWorld}}</div>
              {{#if older}}<div class="sr6i-error">{{localize "SR6I.OlderWarning"}}</div>{{/if}}
              <div class="sr6i-choices">
                {{#each choices}}
                <label><input type="radio" name="choice-{{@../index}}" value="{{value}}" {{#if checked}}checked{{/if}}> {{label}}</label>
                {{/each}}
              </div>
            {{/if}}
          </div>
        </li>
        {{/each}}
      </ul>
      <p class="sr6i-progress" role="status">{{progress}}</p>
      <footer class="form-footer">
        <button type="button" data-action="import" {{#if busy}}disabled{{/if}}><i class="fas fa-file-import"></i> {{localize "SR6I.Import"}}</button>
      </footer>
    {{/if}}
  {{/if}}
</div>
