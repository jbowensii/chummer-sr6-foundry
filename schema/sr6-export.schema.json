{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chummer-sr6:export:1",
  "title": "Chummer SR6 export v1",
  "description": "Shadowrun 6 runners, NPCs or book data from Chummer Anarchy 2.0 (docs/sr6-export-format.md). Every number in values is Chummer’s own; attrs and parts keep the entry as printed. The envelope, book and NPC block allow extra properties so later minor additions stay readable; the runner, items, purchases and values are closed (unevaluatedProperties false where a def extends item).",
  "type": "object",
  "required": [
    "format",
    "version",
    "kind",
    "exportedAt",
    "app",
    "descriptions"
  ],
  "properties": {
    "format": {
      "const": "chummer-sr6-export"
    },
    "version": {
      "const": 1
    },
    "kind": {
      "enum": [
        "runners",
        "books"
      ]
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time"
    },
    "app": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "descriptions": {
      "type": "boolean"
    },
    "runners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/runner"
      }
    },
    "books": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/book"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "runners"
          }
        }
      },
      "then": {
        "required": [
          "runners"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "books"
          }
        }
      },
      "then": {
        "required": [
          "books"
        ]
      }
    }
  ],
  "$defs": {
    "attr": {
      "enum": [
        "bod",
        "agi",
        "rea",
        "str",
        "wil",
        "log",
        "int",
        "cha",
        "edg",
        "mag",
        "res"
      ]
    },
    "kind": {
      "enum": [
        "priorities",
        "metatypes",
        "attributes",
        "skills",
        "qualities",
        "weapons",
        "armor",
        "augmentations",
        "grades",
        "electronics",
        "programs",
        "gear",
        "vehicles",
        "spells",
        "rituals",
        "adeptpowers",
        "complexforms",
        "metamagics",
        "echoes",
        "martialarts",
        "martialtechniques",
        "traditions",
        "critterpowers",
        "critters",
        "spirits",
        "npcs",
        "sprites",
        "lifestyles",
        "contacts",
        "lifemodules",
        "actions",
        "packs",
        "vehicledesign",
        "ammotypes",
        "mentorspirits",
        "datastructures",
        "qualitypaths",
        "spellfeatures",
        "contacttypes",
        "qualitysets",
        "licencetypes",
        "magictypes",
        "ruleoptions",
        "senses",
        "trueelements",
        "categories",
        "rules"
      ]
    },
    "values": {
      "description": "Chummer’s numbers for an entry at a rating; a key is absent when the book prints nothing or Chummer can’t read it (never NaN or null).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rating": {
          "type": "number"
        },
        "cost": {
          "type": "number"
        },
        "avail": {
          "type": "number"
        },
        "legality": {
          "enum": [
            "L",
            "I",
            "F"
          ]
        },
        "essence": {
          "type": "number"
        },
        "capacity": {
          "type": "number"
        },
        "dv": {
          "type": "number"
        },
        "stun": {
          "type": "boolean"
        },
        "ar": {
          "type": "array",
          "items": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "modes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ammo": {
          "type": "number"
        },
        "defense": {
          "type": "number"
        },
        "social": {
          "description": "An armor's Social modifier: what it adds to the wearer's Social Rating (Charisma + the armor worn's).",
          "type": "number"
        },
        "karma": {
          "type": "number"
        },
        "powerCost": {
          "type": "number"
        },
        "drain": {
          "type": "number"
        },
        "fade": {
          "type": "number"
        },
        "threshold": {
          "type": "number"
        },
        "vehicle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "handling": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "accel": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "interval": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "topSpeed": {
              "type": "number"
            },
            "body": {
              "type": "number"
            },
            "armor": {
              "type": "number"
            },
            "pilot": {
              "type": "number"
            },
            "sensor": {
              "type": "number"
            },
            "seats": {
              "type": "number"
            }
          }
        }
      }
    },
    "bonus": {
      "description": "Evaluated: × rating when perRating, × qty. defense: Defense Rating. skill: that skill's dice pool, by its catalog id and name. An accessory's bonuses are its host's, never the runner's.",
      "type": "object",
      "required": [
        "target",
        "value"
      ],
      "properties": {
        "target": {
          "enum": [
            "bod",
            "agi",
            "rea",
            "str",
            "wil",
            "log",
            "int",
            "cha",
            "edg",
            "mag",
            "res",
            "initDice",
            "defense",
            "physical",
            "stun",
            "overflow",
            "skill"
          ]
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "value": {
          "type": "number"
        },
        "when": {
          "description": "Only on some tests or situations (a voice modulator's sound-based Con tests): in derivedOn's totals, never derived's.",
          "type": "string"
        },
        "switch": {
          "description": "How it is turned on; none: always on (in derived). A switchable one counts in derivedOn's totals, the bracket a book prints.",
          "enum": [
            "wireless",
            "activated",
            "sustained",
            "conditional"
          ]
        },
        "spec": {
          "description": "Only on a specialization's tests: in that specialization's pool when the runner has it, else in derivedOn's.",
          "type": "string"
        },
        "affects": {
          "description": "A spell's or complex form's: on its caster (while sustained) or its target(s) (never counted on the caster).",
          "enum": [
            "caster",
            "target"
          ]
        }
      },
      "if": {
        "properties": {
          "target": {
            "const": "skill"
          }
        }
      },
      "then": {
        "required": [
          "id",
          "name"
        ]
      }
    },
    "part": {
      "type": "object",
      "required": [
        "tag",
        "text"
      ],
      "properties": {
        "tag": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "item": {
      "description": "A thing on a runner or in a book: the catalog entry as printed (attrs, parts) plus Chummer’s values. A base: each def that uses it closes it with unevaluatedProperties false.",
      "type": "object",
      "required": [
        "kind",
        "name",
        "canon",
        "attrs",
        "parts",
        "values"
      ],
      "properties": {
        "uid": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "name": {
          "type": "string"
        },
        "label": {
          "description": "How Chummer shows the item when that differs from its printed name: its category first (\"Cyberlimb: Arm (synthetic)\"). The category itself is attrs.category (attrs.group when the name needs it).",
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "page": {
          "type": "integer"
        },
        "canon": {
          "type": "boolean"
        },
        "attrs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/part"
          }
        },
        "values": {
          "$ref": "#/$defs/values"
        },
        "description": {
          "type": "string"
        },
        "effects": {
          "description": "What the entry's printed text and tables say it does (the catalog's <effect>, docs/sr6-data-format.md Effects): target attr:<abbr>, attr-max:<abbr>, skill:<id>, test:<type>, derived:<name>, matrix:<name>, item:<field>, action:<name>, lifestyle:<name> or resource:<name>; op add, set, edge, edge-cost, edge-cost-set, no-edge, no-edge-gain, wild-die, hits or threshold; value as printed (a number, R or R*N per rating, item:ar five comma-separated bands); low: read with low confidence (shown, never applied); switch: how it is turned on (a switchable one counts in the bracketed total); when: the condition's words; spec: the specialization it is limited to; affects: a spell's or complex form's, on its caster or its target(s).",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target",
              "op",
              "value"
            ],
            "properties": {
              "target": {
                "type": "string"
              },
              "op": {
                "enum": [
                  "add",
                  "set",
                  "edge",
                  "edge-cost",
                  "edge-cost-set",
                  "no-edge",
                  "no-edge-gain",
                  "wild-die",
                  "hits",
                  "threshold"
                ]
              },
              "value": {
                "type": "string"
              },
              "low": {
                "const": true
              },
              "switch": {
                "enum": [
                  "wireless",
                  "activated",
                  "sustained",
                  "conditional"
                ]
              },
              "when": {
                "type": "string"
              },
              "spec": {
                "type": "string"
              },
              "affects": {
                "enum": [
                  "caster",
                  "target"
                ]
              }
            }
          }
        },
        "links": {
          "description": "Another entry this one grants (rel grants) or works as (rel as), by its printed name (and kind and id when the book tells): a reader uses that entry's effects.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rel",
              "name"
            ],
            "properties": {
              "rel": {
                "enum": [
                  "grants",
                  "as"
                ]
              },
              "name": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "level": {
                "type": "integer"
              },
              "when": {
                "type": "string"
              }
            }
          }
        },
        "tests": {
          "description": "A test the entry's text calls for (the catalog's <test>): skill + attribute (threshold).",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "skill",
              "attr"
            ],
            "properties": {
              "skill": {
                "type": "string"
              },
              "attr": {
                "type": "string"
              },
              "threshold": {
                "type": "integer"
              }
            }
          }
        },
        "aliases": {
          "description": "The ids the entry had in earlier imports (the catalog's <alias id kind>): kind only when it was another kind.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "$ref": "#/$defs/kind"
              }
            }
          }
        }
      }
    },
    "purchase": {
      "$ref": "#/$defs/item",
      "unevaluatedProperties": false,
      "required": [
        "uid",
        "qty",
        "worn",
        "bonuses",
        "accessories"
      ],
      "properties": {
        "uid": {
          "type": "string"
        },
        "qty": {
          "type": "number"
        },
        "grade": {
          "type": "string"
        },
        "worn": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        },
        "bonuses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bonus"
          }
        },
        "accessories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/purchase"
          }
        }
      }
    },
    "martialArt": {
      "description": "A martial arts style on a runner, with the techniques learned under it (its signature one included).",
      "$ref": "#/$defs/item",
      "unevaluatedProperties": false,
      "required": [
        "uid",
        "techniques"
      ],
      "properties": {
        "uid": {
          "type": "string"
        },
        "techniques": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/technique"
          }
        }
      }
    },
    "technique": {
      "$ref": "#/$defs/item",
      "unevaluatedProperties": false,
      "required": [
        "uid"
      ],
      "properties": {
        "uid": {
          "type": "string"
        },
        "requires": {
          "description": "The prerequisites the technique prints (an adept power, another technique, a quality, an augmentation, or other), name as printed; met: whether the runner has it (absent when it can't be told: other, or an augmentation printed as an amount). Absent when it prints none, and in files written before prerequisites were read.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "name"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "adeptpower",
                  "technique",
                  "quality",
                  "augmentation",
                  "other"
                ]
              },
              "name": {
                "type": "string"
              },
              "met": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "quality": {
      "$ref": "#/$defs/item",
      "unevaluatedProperties": false,
      "required": [
        "uid",
        "positive",
        "level",
        "free"
      ],
      "properties": {
        "uid": {
          "type": "string"
        },
        "positive": {
          "type": "boolean"
        },
        "level": {
          "type": "number"
        },
        "free": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "pick": {
      "$ref": "#/$defs/item",
      "unevaluatedProperties": false,
      "required": [
        "uid",
        "pick",
        "bonuses"
      ],
      "properties": {
        "uid": {
          "type": "string"
        },
        "pick": {
          "enum": [
            "spells",
            "rituals",
            "adeptpowers",
            "complexforms",
            "metamagics",
            "echoes"
          ]
        },
        "level": {
          "type": "number"
        },
        "bonuses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bonus"
          }
        }
      }
    },
    "entry": {
      "$ref": "#/$defs/item",
      "unevaluatedProperties": false,
      "required": [
        "id",
        "source",
        "page"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "page": {
          "type": "integer"
        },
        "npc": {
          "$ref": "#/$defs/npc"
        }
      }
    },
    "npc": {
      "type": "object",
      "required": [
        "kind",
        "stats",
        "lines",
        "pools"
      ],
      "properties": {
        "kind": {
          "enum": [
            "grunt",
            "critter",
            "spirit",
            "sprite"
          ]
        },
        "rating": {
          "type": "number"
        },
        "group": {
          "type": "string"
        },
        "from": {
          "type": "object",
          "required": [
            "kind",
            "id",
            "name",
            "source",
            "page"
          ],
          "properties": {
            "kind": {
              "$ref": "#/$defs/kind"
            },
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "page": {
              "type": "integer"
            }
          }
        },
        "stats": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "label",
              "printed",
              "value",
              "ok"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "printed": {
                "type": "string"
              },
              "value": {
                "type": "string"
              },
              "ok": {
                "type": "boolean"
              }
            }
          }
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "part",
              "text"
            ],
            "properties": {
              "part": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "pools": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "rating",
              "printed"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "rating": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "attr": {
                "type": "string"
              },
              "pool": {
                "type": "number"
              },
              "printed": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "pool": {
      "type": "object",
      "required": [
        "skill",
        "label",
        "rank",
        "attr",
        "dp"
      ],
      "properties": {
        "skill": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "rank": {
          "type": "number"
        },
        "attr": {
          "type": "string"
        },
        "dp": {
          "type": "number"
        },
        "spec": {
          "type": "string"
        },
        "expertise": {
          "type": "string"
        },
        "specDp": {
          "type": "number"
        },
        "expertiseDp": {
          "type": "number"
        }
      }
    },
    "init": {
      "type": "object",
      "required": [
        "base",
        "dice"
      ],
      "properties": {
        "base": {
          "type": "number"
        },
        "dice": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "updatedAt",
        "exportedAt",
        "streetName",
        "realName",
        "finalized",
        "metatype",
        "magic",
        "portrait",
        "token",
        "attributes",
        "essence",
        "edge",
        "skills",
        "knowledge",
        "qualities",
        "picks",
        "purchases",
        "contacts",
        "lifestyle",
        "sins",
        "karma",
        "nuyen",
        "background",
        "notes",
        "ledger"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        },
        "exportedAt": {
          "type": "string"
        },
        "streetName": {
          "type": "string"
        },
        "realName": {
          "type": "string"
        },
        "gender": {
          "description": "Optional, as the player wrote it.",
          "type": "string"
        },
        "finalized": {
          "type": "boolean"
        },
        "metatype": {
          "type": "object",
          "required": [
            "id",
            "name"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        },
        "magic": {
          "type": "object",
          "required": [
            "kind",
            "initiation",
            "submersion"
          ],
          "properties": {
            "kind": {
              "enum": [
                "full",
                "aspected",
                "mystic-adept",
                "adept",
                "technomancer",
                "mundane"
              ]
            },
            "tradition": {
              "type": "string"
            },
            "drainAttr": {
              "enum": [
                "log",
                "int",
                "cha"
              ]
            },
            "aspectedSkill": {
              "type": "string"
            },
            "initiation": {
              "type": "number"
            },
            "submersion": {
              "type": "number"
            }
          }
        },
        "portrait": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^data:image/(png|jpeg);base64,"
        },
        "token": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^data:image/(png|jpeg);base64,"
        },
        "attributes": {
          "type": "object",
          "required": [
            "bod",
            "agi",
            "rea",
            "str",
            "wil",
            "log",
            "int",
            "cha",
            "edg",
            "mag",
            "res"
          ],
          "properties": {
            "bod": {
              "type": "object",
              "required": [
                "natural",
                "augmented"
              ],
              "properties": {
                "natural": {
                  "type": "number"
                },
                "augmented": {
                  "type": "number"
                },
                "switched": {
                  "description": "With the switchable and conditional effects on (the bracket); only when it differs from augmented.",
                  "type": "number"
                }
              }
